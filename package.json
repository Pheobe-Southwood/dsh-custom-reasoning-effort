{
  "name": "dsh-custom-reasoning-effort",
  "description": "Reasoning-effort toolkit for custom DSH LLM provider routes: backfill the per-model levels the composer's picker needs, and remember the level each route was last left on",
  "version": "0.4.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=20.19.0" },
  "repository": { "type": "git", "url": "git+https://github.com/Pheobe-Southwood/dsh-custom-reasoning-effort.git" },
  "bugs": { "url": "https://github.com/Pheobe-Southwood/dsh-custom-reasoning-effort/issues" },
  "homepage": "https://github.com/Pheobe-Southwood/dsh-custom-reasoning-effort#readme",
  "keywords": ["deepseek-harness", "dsh", "llm", "reasoning-effort", "effort-memory", "settings", "cordis"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": { "@deepseek-ai/schemastery": "~3.18.4" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "dsh-effort-memory": "file:./effort-memory"
  },
  "license": "MIT",
  "files": ["cordis.patch.yml", "lib", "effort-memory", "scripts", "README.md", "CONTEXT.md", "CHANGELOG.md", "docs", "LICENSE"],
  "scripts": {
    "postinstall": "node scripts/link-effort-memory-package.mjs",
    "lint": "eslint .",
    "test:host": "node --test test/*.test.mjs",
    "test:mount": "node test/mount-check.mjs",
    "test": "npm run test:host && npm run test:mount",
    "test:pack": "npm pack --dry-run",
    "check": "npm run lint && npm test && npm run test:pack",
    "prepublishOnly": "npm run check"  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0"
  }
}
